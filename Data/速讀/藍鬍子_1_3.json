{
  "articles": [
    {
      "id": "art_bluebeard_001",
      "title": "藍鬍子",
      "author": "馮內果",
      "language": "zh-Hant",
      "category": "文學",
      "difficulty": "中等",
      "recommendedWPM": 280,
      "content": {
        "chapters": [
          {
            "id": "ch1",
            "title": "第一章",
            "order": 1,
            "estimatedReadingTimeSec": 600,
            "sections": [
              {
                "id": "ch1_sec1",
                "title": "第一節",
                "order": 1,
                "paragraphs": [
                  {
                    "id": "ch1_sec1_p1",
                    "clauses": [
                      {"id": "c1", "text": "當我為這部有關我生命的故事寫下結束二字時", "punctuation": "，", "tokens": ["當我", "為", "這部", "有關", "我生命", "的故事", "寫下", "結束", "二字時"]},
                      {"id": "c2", "text": "我深深覺得有必要趕緊回到書的最前面加寫一段話", "punctuation": "。", "tokens": ["我", "深深", "覺得", "有必要", "趕緊", "回到", "書的", "最前面", "加寫", "一段話"]},
                      {"id": "c3", "text": "這個舉動一如跑到前門", "punctuation": "，", "tokens": ["這個", "舉動", "一如", "跑到", "前門"]},
                      {"id": "c4", "text": "向應邀來訪的客人致上歉意", "punctuation": "：", "tokens": ["向", "應邀", "來訪", "的", "客人", "致上", "歉意"]},
                      {"id": "c5", "text": "我原先答應寫篇自傳的", "punctuation": "，", "tokens": ["我", "原先", "答應", "寫篇", "自傳", "的"]},
                      {"id": "c6", "text": "但調理過程中出了一點岔錯", "punctuation": "，", "tokens": ["但", "調理", "過程", "中", "出了", "一點", "岔錯"]},
                      {"id": "c7", "text": "把這篇自傳同時變成了記敘過去那個混亂夏日的流水帳", "punctuation": "。", "tokens": ["把", "這篇", "自傳", "同時", "變成了", "記敘", "過去", "那個", "混亂", "夏日", "的", "流水帳"]},
                      {"id": "c8", "text": "當然", "punctuation": "，", "tokens": ["當然"]},
                      {"id": "c9", "text": "如果不合各位的胃口", "punctuation": "，", "tokens": ["如果", "不合", "各位", "的", "胃口"]},
                      {"id": "c10", "text": "我們還是可以換個口味", "punctuation": "，", "tokens": ["我們", "還是", "可以", "換個", "口味"]},
                      {"id": "c11", "text": "吃片披薩", "punctuation": "。", "tokens": ["吃片", "披薩"]},
                      {"id": "c12", "text": "所以", "punctuation": "，", "tokens": ["所以"]},
                      {"id": "c13", "text": "還是說聲", "punctuation": "：", "tokens": ["還是", "說聲"]},
                      {"id": "c14", "text": "歡迎光臨", "punctuation": "。", "tokens": ["歡迎", "光臨"]}
                    ]
                  },
                  {
                    "id": "ch1_sec1_p2",
                    "clauses": [
                      {"id": "c15", "text": "我是已過氣的美國畫家拉伯．卡拉貝金安", "punctuation": "，", "tokens": ["我是", "已", "過氣", "的", "美國", "畫家", "拉伯", "卡拉貝金安"]},
                      {"id": "c16", "text": "一名獨眼男子", "punctuation": "。", "tokens": ["一名", "獨眼", "男子"]},
                      {"id": "c17", "text": "我是由第一代移民的雙親", "punctuation": "，", "tokens": ["我是", "由", "第一代", "移民", "的", "雙親"]},
                      {"id": "c18", "text": "於西元一九一六年生於加州的聖．伊格納修", "punctuation": "，", "tokens": ["於", "西元", "一九一六年", "生於", "加州", "的", "聖", "伊格納修"]},
                      {"id": "c19", "text": "而於七十一年後的今天寫下自傳", "punctuation": "。", "tokens": ["而", "於", "七十一年", "後", "的", "今天", "寫下", "自傳"]},
                      {"id": "c20", "text": "懶得算數的話", "punctuation": "，", "tokens": ["懶得", "算數", "的", "話"]},
                      {"id": "c21", "text": "現在是西元一九八七年", "punctuation": "。", "tokens": ["現在", "是", "西元", "一九八七年"]},
                      {"id": "c22", "text": "天生並非獨眼的我", "punctuation": "，", "tokens": ["天生", "並非", "獨眼", "的", "我"]},
                      {"id": "c23", "text": "是在第二次大戰即將結束期間", "punctuation": "，", "tokens": ["是", "在", "第二次", "大戰", "即將", "結束", "期間"]},
                      {"id": "c24", "text": "於盧森堡率領一排兵工時失去左眼的", "punctuation": "。", "tokens": ["於", "盧森堡", "率領", "一排", "兵工", "時", "失去", "左眼", "的"]}
                    ]
                  },
                  {
                    "id": "ch1_sec1_p3",
                    "clauses": [
                      {"id": "c25", "text": "這群兵工可謂集繁華世界之龍蛇藝術家之大成", "punctuation": "，", "tokens": ["這群", "兵工", "可謂", "集", "繁華", "世界", "之", "龍蛇", "藝術家", "之", "大成"]},
                      {"id": "c26", "text": "雖然當時我們專攻偽裝", "punctuation": "，", "tokens": ["雖然", "當時", "我們", "專攻", "偽裝"]},
                      {"id": "c27", "text": "但卻和一般大頭兵一樣", "punctuation": "，", "tokens": ["但", "卻", "和", "一般", "大頭兵", "一樣"]},
                      {"id": "c28", "text": "正為各自的生存掙扎著", "punctuation": "。", "tokens": ["正", "為", "各自", "的", "生存", "掙扎", "著"]},
                      {"id": "c29", "text": "這個單位全由藝術家組成", "punctuation": "，", "tokens": ["這個", "單位", "全", "由", "藝術家", "組成"]},
                      {"id": "c30", "text": "因為軍隊中有個理論認為", "punctuation": "，", "tokens": ["因為", "軍隊", "中", "有", "個", "理論", "認為"]},
                      {"id": "c31", "text": "只要是藝術家", "punctuation": "，", "tokens": ["只要", "是", "藝術家"]},
                      {"id": "c32", "text": "對偽裝易容就會有一手", "punctuation": "。", "tokens": ["對", "偽裝", "易容", "就", "會有", "一手"]}
                    ]
                  },
                  {
                    "id": "ch1_sec1_p4",
                    "clauses": [
                      {"id": "c33", "text": "於是", "punctuation": "，", "tokens": ["於是"]},
                      {"id": "c34", "text": "我們就這麼上了戰場", "punctuation": "，", "tokens": ["我們", "就", "這麼", "上了", "戰場"]},
                      {"id": "c35", "text": "也不負所託", "punctuation": "。", "tokens": ["也", "不負", "所託"]},
                      {"id": "c36", "text": "我們令德軍產生幻覺", "punctuation": "，", "tokens": ["我們", "令", "德軍", "產生", "幻覺"]},
                      {"id": "c37", "text": "以為我方防線後", "punctuation": "，", "tokens": ["以為", "我方", "防線", "後"]},
                      {"id": "c38", "text": "有一些事實上並不存在的危險", "punctuation": "。", "tokens": ["有", "一些", "事實", "上", "並", "不存在", "的", "危險"]},
                      {"id": "c39", "text": "是的", "punctuation": "，", "tokens": ["是的"]},
                      {"id": "c40", "text": "而我們也受到特殊待遇", "punctuation": "，", "tokens": ["而", "我們", "也", "受到", "特殊", "待遇"]},
                      {"id": "c41", "text": "能像一般的藝術家一樣過活", "punctuation": "，", "tokens": ["能", "像", "一般", "的", "藝術家", "一樣", "過活"]},
                      {"id": "c42", "text": "毋須顧忌軍隊的禮節與衣著", "punctuation": "。", "tokens": ["毋須", "顧忌", "軍隊", "的", "禮節", "與", "衣著"]},
                      {"id": "c43", "text": "我們也並不隸屬於一個師或一個團", "punctuation": "，", "tokens": ["我們", "也", "並", "不隸屬", "於", "一個", "師", "或", "一個", "團"]},
                      {"id": "c44", "text": "而是直接受命於同盟國軍隊的最高總部", "punctuation": "。", "tokens": ["而是", "直接", "受命", "於", "同盟國", "軍隊", "的", "最高", "總部"]}
                    ]
                  },
                  {
                    "id": "ch1_sec1_p5",
                    "clauses": [
                      {"id": "c45", "text": "由於我是招募入伍的", "punctuation": "，", "tokens": ["由於", "我是", "招募", "入伍", "的"]},
                      {"id": "c46", "text": "並且在美國參戰前二年位階已達少尉", "punctuation": "，", "tokens": ["並且", "在", "美國", "參戰", "前", "二年", "位階", "已達", "少尉"]},
                      {"id": "c47", "text": "所以在戰後我的官階至少也可達到中校", "punctuation": "。", "tokens": ["所以", "在", "戰後", "我的", "官階", "至少", "也", "可", "達到", "中校"]},
                      {"id": "c48", "text": "但我婉拒上尉以上的晉升", "punctuation": "，", "tokens": ["但", "我", "婉拒", "上尉", "以上", "的", "晉升"]},
                      {"id": "c49", "text": "以便能繼續留在這個三十六人的大家庭中", "punctuation": "，", "tokens": ["以便", "能", "繼續", "留在", "這個", "三十六人", "的", "大家庭", "中"]},
                      {"id": "c50", "text": "這是我第一次和這麼大的家庭共處", "punctuation": "。", "tokens": ["這是", "我", "第一次", "和", "這麼", "大", "的", "家庭", "共處"]}
                    ]
                  }
                ]
              },
              {
                "id": "ch1_sec2",
                "title": "第二節",
                "order": 2,
                "paragraphs": [
                  {
                    "id": "ch1_sec2_p1",
                    "clauses": [
                      {"id": "c51", "text": "我的雙親原本在歐洲所擁有的家庭都比我先前敘述的家庭來得大", "punctuation": "──", "tokens": ["我的", "雙親", "原本", "在", "歐洲", "所", "擁有", "的", "家庭", "都", "比我", "先前", "敘述", "的", "家庭", "來得", "大"]},
                      {"id": "c52", "text": "而且", "punctuation": "，", "tokens": ["而且"]},
                      {"id": "c53", "text": "都是真的血親", "punctuation": "。", "tokens": ["都是", "真的", "血親"]},
                      {"id": "c54", "text": "他們於土耳其帝國對亞美尼亞人的百萬大屠殺中", "punctuation": "，", "tokens": ["他們", "於", "土耳其", "帝國", "對", "亞美尼亞人", "的", "百萬", "大屠殺", "中"]},
                      {"id": "c55", "text": "痛失這些血親", "punctuation": "。", "tokens": ["痛失", "這些", "血親"]}
                    ]
                  },
                  {
                    "id": "ch1_sec2_p2",
                    "clauses": [
                      {"id": "c56", "text": "這些亞美尼亞人由於兩個原因被視為危險民族而遭屠殺", "punctuation": "：", "tokens": ["這些", "亞美尼亞人", "由於", "兩個", "原因", "被視為", "危險", "民族", "而", "遭", "屠殺"]},
                      {"id": "c57", "text": "一是由於他們既聰明又受過較高的教育", "punctuation": "，", "tokens": ["一是", "由於", "他們", "既", "聰明", "又", "受過", "較高", "的", "教育"]},
                      {"id": "c58", "text": "二是因為這些人有親戚屬於國界另一端的敵國", "punctuation": "，", "tokens": ["二是", "因為", "這些", "人", "有", "親戚", "屬於", "國界", "另一端", "的", "敵國"]},
                      {"id": "c59", "text": "也就是蘇俄帝國", "punctuation": "。", "tokens": ["也就是", "蘇俄", "帝國"]}
                    ]
                  },
                  {
                    "id": "ch1_sec2_p3",
                    "clauses": [
                      {"id": "c60", "text": "那是一個帝國主義的時代", "punctuation": "，", "tokens": ["那是", "一個", "帝國主義", "的", "時代"]},
                      {"id": "c61", "text": "和現在並無兩樣", "punctuation": "，", "tokens": ["和", "現在", "並無", "兩樣"]},
                      {"id": "c62", "text": "只不過當時的國家並不那麼善於偽裝", "punctuation": "。", "tokens": ["只不過", "當時", "的", "國家", "並", "不那麼", "善於", "偽裝"]}
                    ]
                  },
                  {
                    "id": "ch1_sec2_p4",
                    "clauses": [
                      {"id": "c63", "text": "和土耳其帝國聯合的德意志帝國", "punctuation": "，", "tokens": ["和", "土耳其", "帝國", "聯合", "的", "德意志", "帝國"]},
                      {"id": "c64", "text": "派了一群殘酷的軍事觀察家前來審核這一場本世紀的第一次殲滅行動", "punctuation": "，", "tokens": ["派了", "一群", "殘酷", "的", "軍事", "觀察家", "前來", "審核", "這一場", "本世紀", "的", "第一次", "殲滅", "行動"]},
                      {"id": "c65", "text": "這種計畫性的摧毀在當時甚至還於史無據、無以名之", "punctuation": "。", "tokens": ["這種", "計畫性", "的", "摧毀", "在", "當時", "甚至", "還", "於史無據", "無以名之"]},
                      {"id": "c66", "text": "因這次屠殺所創造出的新名詞", "punctuation": "，", "tokens": ["因", "這次", "屠殺", "所", "創造", "出", "的", "新名詞"]},
                      {"id": "c67", "text": "現在則舉世皆知其定義為一場詳密計畫", "punctuation": "，", "tokens": ["現在", "則", "舉世", "皆知", "其", "定義", "為", "一場", "詳密", "計畫"]},
                      {"id": "c68", "text": "用以殲滅一個族群", "punctuation": "，", "tokens": ["用以", "殲滅", "一個", "族群"]},
                      {"id": "c69", "text": "不論男女老少皆格殺勿論的行為", "punctuation": "。", "tokens": ["不論", "男女老少", "皆", "格殺勿論", "的", "行為"]}
                    ]
                  },
                  {
                    "id": "ch1_sec2_p5",
                    "clauses": [
                      {"id": "c70", "text": "這種野心勃勃的計畫和工業界所面臨的問題十分相似", "punctuation": "：", "tokens": ["這種", "野心勃勃", "的", "計畫", "和", "工業界", "所", "面臨", "的", "問題", "十分", "相似"]},
                      {"id": "c71", "text": "重點只在於如何以廉價而迅速的手法", "punctuation": "，", "tokens": ["重點", "只在於", "如何", "以", "廉價", "而", "迅速", "的", "手法"]},
                      {"id": "c72", "text": "宰殺這一大群生物", "punctuation": "，", "tokens": ["宰殺", "這", "一大群", "生物"]},
                      {"id": "c73", "text": "確保無一得以倖免後", "punctuation": "，", "tokens": ["確保", "無一", "得以", "倖免", "後"]},
                      {"id": "c74", "text": "再想辦法處理堆積如山的屍骨", "punctuation": "。", "tokens": ["再", "想辦法", "處理", "堆積如山", "的", "屍骨"]}
                    ]
                  },
                  {
                    "id": "ch1_sec2_p6",
                    "clauses": [
                      {"id": "c75", "text": "土耳其雖然是這個行動的先驅", "punctuation": "，", "tokens": ["土耳其", "雖然", "是", "這個", "行動", "的", "先驅"]},
                      {"id": "c76", "text": "並沒有經營大事業的本事", "punctuation": "，", "tokens": ["並", "沒有", "經營", "大", "事業", "的", "本事"]},
                      {"id": "c77", "text": "也未曾使用特殊的工具來完成這場行動", "punctuation": "。", "tokens": ["也", "未曾", "使用", "特殊", "的", "工具", "來", "完成", "這場", "行動"]},
                      {"id": "c78", "text": "而相反地", "punctuation": "，", "tokens": ["而", "相反", "地"]},
                      {"id": "c79", "text": "德國人則在二十五年後", "punctuation": "，", "tokens": ["德國人", "則", "在", "二十五年", "後"]},
                      {"id": "c80", "text": "在同樣的行動上展現了他們在這方面的才能與技術", "punctuation": "。", "tokens": ["在", "同樣", "的", "行動", "上", "展現", "了", "他們", "在", "這方面", "的", "才能", "與", "技術"]}
                    ]
                  }
                ]
              },
              {
                "id": "ch1_sec3",
                "title": "第三節",
                "order": 3,
                "paragraphs": [
                  {
                    "id": "ch1_sec3_p1",
                    "clauses": [
                      {"id": "c81", "text": "而我的母親", "punctuation": "，", "tokens": ["而", "我的", "母親"]},
                      {"id": "c82", "text": "當時依然小姑獨處", "punctuation": "，", "tokens": ["當時", "依然", "小姑", "獨處"]},
                      {"id": "c83", "text": "則只能在屍體中裝死以求生存", "punctuation": "。", "tokens": ["則", "只能", "在", "屍體", "中", "裝死", "以", "求生", "存"]},
                      {"id": "c84", "text": "我的父親", "punctuation": "，", "tokens": ["我的", "父親"]},
                      {"id": "c85", "text": "當時還未娶", "punctuation": "，", "tokens": ["當時", "還", "未娶"]},
                      {"id": "c86", "text": "則在軍人前來時", "punctuation": "，", "tokens": ["則", "在", "軍人", "前來", "時"]},
                      {"id": "c87", "text": "躲藏在他所任教的學校廁所內", "punctuation": "。", "tokens": ["躲藏", "在", "他", "所", "任教", "的", "學校", "廁所", "內"]},
                      {"id": "c88", "text": "當時學校正放學", "punctuation": "，", "tokens": ["當時", "學校", "正", "放學"]},
                      {"id": "c89", "text": "我未來的父親則留在學校寫詩", "punctuation": "，", "tokens": ["我", "未來", "的", "父親", "則", "留在", "學校", "寫詩"]},
                      {"id": "c90", "text": "這是他有一回告訴我的", "punctuation": "。", "tokens": ["這是", "他", "有", "一回", "告訴", "我的"]},
                      {"id": "c91", "text": "不久", "punctuation": "，", "tokens": ["不久"]},
                      {"id": "c92", "text": "他聽見軍人前來的聲音", "punctuation": "，", "tokens": ["他", "聽見", "軍人", "前來", "的", "聲音"]},
                      {"id": "c93", "text": "明瞭他們的意圖", "punctuation": "。", "tokens": ["明瞭", "他們", "的", "意圖"]},
                      {"id": "c94", "text": "父親從未真正聽到或目睹任何殺戮的行為", "punctuation": "。", "tokens": ["父親", "從未", "真正", "聽到", "或", "目睹", "任何", "殺戮", "的", "行為"]},
                      {"id": "c95", "text": "對他而言", "punctuation": "，", "tokens": ["對", "他", "而言"]},
                      {"id": "c96", "text": "那個村子的死寂", "punctuation": "，", "tokens": ["那個", "村子", "的", "死寂"]},
                      {"id": "c97", "text": "使他成為當地唯一的住民", "punctuation": "，", "tokens": ["使", "他", "成為", "當地", "唯一", "的", "住民"]},
                      {"id": "c98", "text": "在黑暗中全身覆滿了尿與屎", "punctuation": "，", "tokens": ["在", "黑暗", "中", "全身", "覆滿", "了", "尿", "與", "屎"]},
