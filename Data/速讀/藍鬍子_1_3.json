                    "id": "ch2_sec3_p4",
                    "clauses": [
                      {"id": "c213", "text": "我們相遇的經過如下", "punctuation": "：", "tokens": ["我們", "相遇", "的", "經過", "如下"]},
                      {"id": "c214", "text": "她有一日午後誤闖我的私人沙灘", "punctuation": "，", "tokens": ["她", "有", "一日", "午後", "誤闖", "我的", "私人", "沙灘"]},
                      {"id": "c215", "text": "因她並不知道那是私人的", "punctuation": "。", "tokens": ["因", "她", "並", "不知道", "那", "是", "私人", "的"]},
                      {"id": "c216", "text": "由於她痛恨當代藝術", "punctuation": "，", "tokens": ["由於", "她", "痛恨", "當代", "藝術"]},
                      {"id": "c217", "text": "所以從未聽過我的名號", "punctuation": "。", "tokens": ["所以", "從未", "聽過", "我的", "名號"]}
                    ]
                  },
                  {
                    "id": "ch2_sec3_p5",
                    "clauses": [
                      {"id": "c218", "text": "當時我正在海邊作午後小泳", "punctuation": "，", "tokens": ["當時", "我", "正在", "海邊", "作", "午後", "小泳"]},
                      {"id": "c219", "text": "而她則衣冠楚楚地出現", "punctuation": "，", "tokens": ["而", "她", "則", "衣冠楚楚", "地", "出現"]},
                      {"id": "c220", "text": "正做著史賴辛格常做的那件事", "punctuation": "：", "tokens": ["正", "做著", "史賴辛格", "常做", "的", "那件事"]},
                      {"id": "c221", "text": "靜坐在沙灘上", "punctuation": "，", "tokens": ["靜坐", "在", "沙灘", "上"]},
                      {"id": "c222", "text": "癡望著海水", "punctuation": "。", "tokens": ["癡望", "著", "海水"]},
                      {"id": "c223", "text": "唯一使我介意她或者其他人出現在我海灘的原因", "punctuation": "，", "tokens": ["唯一", "使", "我", "介意", "她", "或者", "其他", "人", "出現", "在", "我", "海灘", "的", "原因"]},
                      {"id": "c224", "text": "就是因為我外表上的缺憾", "punctuation": "。", "tokens": ["就是", "因為", "我", "外表", "上", "的", "缺憾"]},
                      {"id": "c225", "text": "事實上", "punctuation": "，", "tokens": ["事實", "上"]},
                      {"id": "c226", "text": "我必須得取下眼罩才能下水", "punctuation": "。", "tokens": ["我", "必須", "得", "取下", "眼罩", "才能", "下水"]},
                      {"id": "c227", "text": "而眼罩下的那隻眼", "punctuation": "，", "tokens": ["而", "眼罩", "下", "的", "那隻眼"]},
                      {"id": "c228", "text": "實在是一團糟", "punctuation": "，", "tokens": ["實在", "是", "一團糟"]},
                      {"id": "c229", "text": "可以算得上是一個炒蛋吧", "punctuation": "。", "tokens": ["可以", "算得上", "是", "一個", "炒蛋", "吧"]},
                      {"id": "c230", "text": "我會因為別人能就近看清我而感到困窘", "punctuation": "。", "tokens": ["我", "會", "因為", "別人", "能", "就近", "看清", "我", "而", "感到", "困窘"]}
                    ]
