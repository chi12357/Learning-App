            "sections": [
              {
                "id": "ch2_sec1",
                "title": "第一節",
                "order": 1,
                "paragraphs": [
                  {
                    "id": "ch2_sec1_p1",
                    "clauses": [
                      {"id": "c100", "text": "艾蒂斯死後", "punctuation": "，", "tokens": ["艾蒂斯", "死後"]},
                      {"id": "c101", "text": "這裡顯得寂寥異常", "punctuation": "。", "tokens": ["這裡", "顯得", "寂寥", "異常"]},
                      {"id": "c102", "text": "我們所擁有的朋友", "punctuation": "，", "tokens": ["我們", "所", "擁有", "的", "朋友"]},
                      {"id": "c103", "text": "都是她的朋友", "punctuation": "，", "tokens": ["都是", "她的", "朋友"]},
                      {"id": "c104", "text": "而非我的", "punctuation": "。", "tokens": ["而", "非", "我的"]},
                      {"id": "c105", "text": "畫家們都避開我", "punctuation": "，", "tokens": ["畫家們", "都", "避開", "我"]},
                      {"id": "c106", "text": "因為我本身作品的荒謬招致一些附庸風雅的人非議", "punctuation": "，", "tokens": ["因為", "我", "本身", "作品", "的", "荒謬", "招致", "一些", "附庸風雅", "的", "人", "非議"]},
                      {"id": "c107", "text": "認為大多數的畫家不是充內行就是真傻子", "punctuation": "。", "tokens": ["認為", "大多數", "的", "畫家", "不是", "充內行", "就是", "真傻子"]},
                      {"id": "c108", "text": "不過", "punctuation": "，", "tokens": ["不過"]},
                      {"id": "c109", "text": "如果我因此而必須孤單", "punctuation": "，", "tokens": ["如果", "我", "因此而", "必須", "孤單"]},
                      {"id": "c110", "text": "還是耐得住的", "punctuation": "。", "tokens": ["還是", "耐得住", "的"]}
                    ]
                  },
                  {
                    "id": "ch2_sec1_p2",
                    "clauses": [
                      {"id": "c111", "text": "我從孩提時代就與孤單為伍了", "punctuation": "。", "tokens": ["我", "從", "孩提", "時代", "就", "與", "孤單", "為伍", "了"]},
                      {"id": "c112", "text": "經濟大蕭條時", "punctuation": "，", "tokens": ["經濟", "大蕭條", "時"]},
                      {"id": "c113", "text": "我也在紐約市與它相伴數年之久", "punctuation": "。", "tokens": ["我", "也", "在", "紐約市", "與", "它", "相伴", "數年", "之", "久"]},
                      {"id": "c114", "text": "當第一任妻子與兩個兒子於一九五六年離我而去", "punctuation": "，", "tokens": ["當", "第一任", "妻子", "與", "兩個", "兒子", "於", "一九五六年", "離", "我", "而去"]},
                      {"id": "c115", "text": "而我自己放棄畫家生涯的時刻", "punctuation": "，", "tokens": ["而", "我", "自己", "放棄", "畫家", "生涯", "的", "時刻"]},
                      {"id": "c116", "text": "我則已能求寂寞而得寂寞", "punctuation": "，", "tokens": ["我", "則", "已", "能", "求", "寂寞", "而", "得", "寂寞"]},
                      {"id": "c117", "text": "無入而不自得了", "punctuation": "。", "tokens": ["無入", "而", "不自得", "了"]}
                    ]
                  },
                  {
                    "id": "ch2_sec1_p3",
                    "clauses": [
                      {"id": "c118", "text": "而我確實也有一名全然屬於我的朋友", "punctuation": "，", "tokens": ["而", "我", "確實", "也", "有", "一名", "全然", "屬於", "我的", "朋友"]},
                      {"id": "c119", "text": "就是小說家保羅．史賴辛格", "punctuation": "，", "tokens": ["就是", "小說家", "保羅", "史賴辛格"]},
                      {"id": "c120", "text": "一個和我一樣的二次大戰傷兵", "punctuation": "。", "tokens": ["一個", "和", "我", "一樣", "的", "二次", "大戰", "傷兵"]},
                      {"id": "c121", "text": "他一個人獨睡在我位於泉村的老家隔壁", "punctuation": "。", "tokens": ["他", "一個人", "獨睡", "在", "我", "位於", "泉村", "的", "老家", "隔壁"]},
                      {"id": "c122", "text": "我說他睡在那裡", "punctuation": "，", "tokens": ["我", "說", "他", "睡", "在", "那裡"]},
                      {"id": "c123", "text": "是因為他幾乎每天白天都到這裡來", "punctuation": "。", "tokens": ["是", "因為", "他", "幾乎", "每天", "白天", "都", "到", "這裡", "來"]}
                    ]
                  },
                  {
                    "id": "ch2_sec1_p4",
                    "clauses": [
                      {"id": "c124", "text": "我認為他現在早已不太執筆了", "punctuation": "，", "tokens": ["我", "認為", "他", "現在", "早已", "不太", "執筆", "了"]},
                      {"id": "c125", "text": "就像我早已封筆數年一般", "punctuation": "。", "tokens": ["就像", "我", "早已", "封筆", "數年", "一般"]},
                      {"id": "c126", "text": "我甚至不會花精力、時間在電話旁的備忘錄上塗鴉", "punctuation": "。", "tokens": ["我", "甚至", "不會", "花", "精力", "時間", "在", "電話旁", "的", "備忘錄", "上", "塗鴉"]}
                    ]
                  }
                ]
              },
              {
                "id": "ch2_sec2",
                "title": "第二節",
                "order": 2,
                "paragraphs": [
                  {
                    "id": "ch2_sec2_p1",
                    "clauses": [
                      {"id": "c127", "text": "保羅是個窮光蛋", "punctuation": "。", "tokens": ["保羅", "是", "個", "窮光蛋"]},
                      {"id": "c128", "text": "他每星期在我這裡用晚餐四、五次", "punctuation": "。", "tokens": ["他", "每星期", "在", "我", "這裡", "用", "晚餐", "四", "五次"]},
                      {"id": "c129", "text": "而白天時", "punctuation": "，", "tokens": ["而", "白天", "時"]},
                      {"id": "c130", "text": "他則任意取食我冰箱或水果籃中的食物", "punctuation": "。", "tokens": ["他", "則", "任意", "取食", "我", "冰箱", "或", "水果籃", "中", "的", "食物"]},
                      {"id": "c131", "text": "所以", "punctuation": "，", "tokens": ["所以"]},
                      {"id": "c132", "text": "我可以肯定", "punctuation": "，", "tokens": ["我", "可以", "肯定"]},
                      {"id": "c133", "text": "我是他營養的主要來源", "punctuation": "。", "tokens": ["我是", "他", "營養", "的", "主要", "來源"]}
                    ]
                  },
                  {
                    "id": "ch2_sec2_p2",
                    "clauses": [
                      {"id": "c134", "text": "我曾在飯後數次向他提議", "punctuation": "：", "tokens": ["我", "曾", "在", "飯後", "數次", "向", "他", "提議"]},
                      {"id": "c135", "text": "保羅", "punctuation": "，", "tokens": ["保羅"]},
                      {"id": "c136", "text": "你為什麼不把房子賣了", "punctuation": "，", "tokens": ["你", "為什麼", "不", "把", "房子", "賣了"]},
                      {"id": "c137", "text": "手邊留點錢", "punctuation": "，", "tokens": ["手邊", "留點", "錢"]},
                      {"id": "c138", "text": "搬到這裡來住", "punctuation": "？", "tokens": ["搬到", "這裡", "來住"]},
                      {"id": "c139", "text": "你看看", "punctuation": "，", "tokens": ["你", "看看"]},
                      {"id": "c140", "text": "我家的空房多得是", "punctuation": "，", "tokens": ["我家", "的", "空房", "多得", "是"]},
                      {"id": "c141", "text": "而我不可能再娶或是交女朋友了", "punctuation": "，", "tokens": ["而", "我", "不可能", "再娶", "或是", "交", "女朋友", "了"]},
                      {"id": "c142", "text": "我想你也不可能", "punctuation": "。", "tokens": ["我", "想", "你", "也", "不可能"]},
                      {"id": "c143", "text": "老天", "punctuation": "，", "tokens": ["老天"]},
                      {"id": "c144", "text": "誰會看上我們兩個", "punctuation": "？", "tokens": ["誰", "會", "看上", "我們", "兩個"]},
                      {"id": "c145", "text": "我們兩個看來活像滿身傷痕的四腳蛇", "punctuation": "。", "tokens": ["我們", "兩個", "看來", "活像", "滿身", "傷痕", "的", "四腳蛇"]},
                      {"id": "c146", "text": "所以", "punctuation": "，", "tokens": ["所以"]},
                      {"id": "c147", "text": "還是搬過來住吧", "punctuation": "！", "tokens": ["還是", "搬過來", "住吧"]},
                      {"id": "c148", "text": "我不會打擾你", "punctuation": "，", "tokens": ["我", "不會", "打擾", "你"]},
                      {"id": "c149", "text": "你也不會干擾我的", "punctuation": "。", "tokens": ["你", "也", "不會", "干擾", "我的"]},
                      {"id": "c150", "text": "還有什麼比這更合情合理的呢", "punctuation": "？", "tokens": ["還有", "什麼", "比", "這", "更", "合情合理", "的", "呢"]}
                    ]
                  },
                  {
                    "id": "ch2_sec2_p3",
                    "clauses": [
                      {"id": "c151", "text": "他的回答和下面這句話總是八九不離十", "punctuation": "。", "tokens": ["他的", "回答", "和", "下面", "這句話", "總是", "八九不離十"]},
                      {"id": "c152", "text": "他會說", "punctuation": "：", "tokens": ["他", "會", "說"]},
                      {"id": "c153", "text": "我只有在家才能寫作", "punctuation": "。", "tokens": ["我", "只有", "在家", "才能", "寫作"]},
                      {"id": "c154", "text": "而那個家", "punctuation": "，", "tokens": ["而", "那個", "家"]},
                      {"id": "c155", "text": "只有一台毛病多多的冰箱", "punctuation": "，", "tokens": ["只有", "一台", "毛病多多", "的", "冰箱"]},
                      {"id": "c156", "text": "還有他形單影隻一人", "punctuation": "。", "tokens": ["還有", "他", "形單影隻", "一人"]},
                      {"id": "c157", "text": "有一回", "punctuation": "，", "tokens": ["有", "一回"]},
                      {"id": "c158", "text": "他還批評過我的房子說", "punctuation": "：", "tokens": ["他", "還", "批評過", "我的", "房子", "說"]},
                      {"id": "c159", "text": "誰能在博物館裡寫作", "punctuation": "？", "tokens": ["誰", "能", "在", "博物館", "裡", "寫作"]}
                    ]
                  },
                  {
                    "id": "ch2_sec2_p4",
                    "clauses": [
                      {"id": "c160", "text": "那麼", "punctuation": "──", "tokens": ["那麼"]},
                      {"id": "c161", "text": "現在我正嘗試的", "punctuation": "，", "tokens": ["現在", "我", "正", "嘗試", "的"]},
                      {"id": "c162", "text": "就是證實這件事的可行性", "punctuation": "。", "tokens": ["就是", "證實", "這件事", "的", "可行性"]},
                      {"id": "c163", "text": "因為", "punctuation": "，", "tokens": ["因為"]},
                      {"id": "c164", "text": "我正在這座博物館裡寫作", "punctuation": "。", "tokens": ["我", "正在", "這座", "博物館", "裡", "寫作"]},
                      {"id": "c165", "text": "是的", "punctuation": "，", "tokens": ["是的"]},
                      {"id": "c166", "text": "這一切都是真的", "punctuation": "。", "tokens": ["這", "一切", "都是", "真的"]},
                      {"id": "c167", "text": "我", "punctuation": "，", "tokens": ["我"]},
                      {"id": "c168", "text": "老頭子卡拉貝金安", "punctuation": "，", "tokens": ["老頭子", "卡拉貝金安"]},
                      {"id": "c169", "text": "曾在視覺藝術上抹黑過自己", "punctuation": "，", "tokens": ["曾", "在", "視覺", "藝術", "上", "抹黑過", "自己"]},
                      {"id": "c170", "text": "現在", "punctuation": "，", "tokens": ["現在"]},
                      {"id": "c171", "text": "正打算向文學進攻", "punctuation": "。", "tokens": ["正", "打算", "向", "文學", "進攻"]}
                    ]
                  },
                  {
                    "id": "ch2_sec2_p5",
                    "clauses": [
                      {"id": "c172", "text": "到底是什麼事激發了像我這樣的老頭子的靈感", "punctuation": "，", "tokens": ["到底", "是", "什麼事", "激發", "了", "像", "我", "這樣", "的", "老頭子", "的", "靈感"]},
                      {"id": "c173", "text": "而痛下改行的決心", "punctuation": "？", "tokens": ["而", "痛下", "改行", "的", "決心"]},
                      {"id": "c174", "text": "答案", "punctuation": "，", "tokens": ["答案"]},
                      {"id": "c175", "text": "可得向女人尋找", "punctuation": "。", "tokens": ["可", "得", "向", "女人", "尋找"]},
                      {"id": "c176", "text": "在我記憶所及", "punctuation": "，", "tokens": ["在", "我", "記憶", "所及"]},
                      {"id": "c177", "text": "一個精力充沛、意見奇多、冶豔而相當年輕的不速之客", "punctuation": "，", "tokens": ["一個", "精力充沛", "意見奇多", "冶豔", "而", "相當", "年輕", "的", "不速之客"]},
                      {"id": "c178", "text": "進入了我的居所", "punctuation": "。", "tokens": ["進入了", "我的", "居所"]},
                      {"id": "c179", "text": "她說她實在無法忍受我鎮日無所事事", "punctuation": "──", "tokens": ["她", "說", "她", "實在", "無法", "忍受", "我", "鎮日", "無所事事"]},
                      {"id": "c180", "text": "所以", "punctuation": "，", "tokens": ["所以"]},
                      {"id": "c181", "text": "為什麼我不做點事", "punctuation": "，", "tokens": ["為什麼", "我", "不做", "點事"]},
                      {"id": "c182", "text": "什麼事都好", "punctuation": "。", "tokens": ["什麼事", "都好"]},
                      {"id": "c183", "text": "如果", "punctuation": "，", "tokens": ["如果"]},
                      {"id": "c184", "text": "我想不出有別的事可做", "punctuation": "，", "tokens": ["我", "想不出", "有", "別的", "事", "可做"]},
                      {"id": "c185", "text": "那我為什麼不寫一寫回憶錄呢", "punctuation": "？", "tokens": ["那", "我", "為什麼", "不", "寫一寫", "回憶錄", "呢"]},
                      {"id": "c186", "text": "確實如此", "punctuation": "，", "tokens": ["確實", "如此"]},
                      {"id": "c187", "text": "我何不姑且一試", "punctuation": "？", "tokens": ["我", "何不", "姑且", "一試"]}
                    ]
                  }
                ]
              },
              {
                "id": "ch2_sec3",
                "title": "第三節",
                "order": 3,
                "paragraphs": [
                  {
                    "id": "ch2_sec3_p1",
                    "clauses": [
                      {"id": "c188", "text": "於是", "punctuation": "，", "tokens": ["於是"]},
                      {"id": "c189", "text": "我發現自己著手去做每一件她認為我必須去做的事", "punctuation": "。", "tokens": ["我", "發現", "自己", "著手", "去", "做", "每一件", "她", "認為", "我", "必須", "去", "做", "的", "事"]},
                      {"id": "c190", "text": "在我與艾蒂斯二十年的婚姻生活中", "punctuation": "，", "tokens": ["在", "我", "與", "艾蒂斯", "二十年", "的", "婚姻", "生活", "中"]},
                      {"id": "c191", "text": "親愛的艾蒂斯從未想過要我去做些什麼事", "punctuation": "。", "tokens": ["親愛的", "艾蒂斯", "從未", "想過", "要", "我", "去", "做些", "什麼事"]},
                      {"id": "c192", "text": "在軍隊時有一些將軍或上校", "punctuation": "，", "tokens": ["在", "軍隊", "時", "有", "一些", "將軍", "或", "上校"]},
                      {"id": "c193", "text": "和這名新入我生命中的女子一般", "punctuation": "，", "tokens": ["和", "這名", "新入", "我", "生命", "中", "的", "女子", "一般"]},
                      {"id": "c194", "text": "曾要我做這做那", "punctuation": "，", "tokens": ["曾", "要", "我", "做", "這", "做", "那"]},
                      {"id": "c195", "text": "但他們畢竟是男人", "punctuation": "，", "tokens": ["但", "他們", "畢竟", "是", "男人"]},
                      {"id": "c196", "text": "而我們當時也正處於戰爭中", "punctuation": "。", "tokens": ["而", "我們", "當時", "也", "正", "處於", "戰爭", "中"]}
                    ]
                  },
                  {
                    "id": "ch2_sec3_p2",
                    "clauses": [
                      {"id": "c197", "text": "這名女子究竟是敵是友", "punctuation": "？", "tokens": ["這名", "女子", "究竟", "是", "敵", "是", "友"]},
                      {"id": "c198", "text": "老實說", "punctuation": "，", "tokens": ["老實", "說"]},
                      {"id": "c199", "text": "我根本不知道她是什麼", "punctuation": "。", "tokens": ["我", "根本", "不知道", "她", "是", "什麼"]},
                      {"id": "c200", "text": "我唯一知道的是", "punctuation": "，", "tokens": ["我", "唯一", "知道", "的", "是"]},
                      {"id": "c201", "text": "除非她覺得自己狀況良好而且準備就緒", "punctuation": "，", "tokens": ["除非", "她", "覺得", "自己", "狀況", "良好", "而且", "準備", "就緒"]},
                      {"id": "c202", "text": "否則", "punctuation": "，", "tokens": ["否則"]},
                      {"id": "c203", "text": "她是不會輕言離去的", "punctuation": "。", "tokens": ["她", "是", "不會", "輕言", "離去", "的"]},
                      {"id": "c204", "text": "而這個念頭卻使我嚇得半死", "punctuation": "。", "tokens": ["而", "這個", "念頭", "卻", "使", "我", "嚇得", "半死"]},
                      {"id": "c205", "text": "救命啊", "punctuation": "！", "tokens": ["救命", "啊"]},
                      {"id": "c206", "text": "她的大名是塞西．伯曼", "punctuation": "。", "tokens": ["她的", "大名", "是", "塞西", "伯曼"]}
                    ]
                  },
                  {
                    "id": "ch2_sec3_p3",
                    "clauses": [
                      {"id": "c207", "text": "她是一名寡婦", "punctuation": "。", "tokens": ["她", "是", "一名", "寡婦"]},
                      {"id": "c208", "text": "她的前夫在巴爾的摩是一名腦部外科大夫", "punctuation": "。", "tokens": ["她的", "前夫", "在", "巴爾的摩", "是", "一名", "腦部", "外科", "大夫"]},
                      {"id": "c209", "text": "在那裡", "punctuation": "，", "tokens": ["在", "那裡"]},
                      {"id": "c210", "text": "她也有一幢和這裡一樣大而空曠的宅子", "punctuation": "。", "tokens": ["她", "也", "有", "一幢", "和", "這裡", "一樣", "大", "而", "空曠", "的", "宅子"]},
                      {"id": "c211", "text": "她的先夫阿比", "punctuation": "，", "tokens": ["她的", "先夫", "阿比"]},
                      {"id": "c212", "text": "在六個月前因腦溢血死亡", "punctuation": "。", "tokens": ["在", "六個月", "前", "因", "腦溢血", "死亡"]}
                    ]
